{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Epic Sax Gandalf",
  "version": "5.0.0",
  "identifier": "com.onemdev.gandalf-sax",
  "build": {
    "frontendDist": "./",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Epic Sax Gandalf",
        "width": 1280,
        "height": 720,
        "fullscreen": false,
        "decorations": true,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost gandalf: http://gandalf.localhost https://gandalf.localhost",
        "img-src": "'self' asset: http://asset.localhost",
        "script-src": "'self'",
        "style-src": "'unsafe-inline' 'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$RESOURCE/**/*",
            "$APPLOCALDATA/**/*",
            "**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../assets/video.mp4"
    ]
  }
}
